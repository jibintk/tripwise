    "@types/react-dom": "^19.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/lib"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "jsx": "react-jsx" } }]

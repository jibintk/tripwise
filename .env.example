# Copy to apps/api/.env and adjust
DATABASE_URL=postgres://tripwise:tripwise@localhost:5432/tripwise
# Optional: without it the API uses an in-memory cache
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-every-environment
PORT=4000
# Supplier timeout budget for search fan-out, in milliseconds
SEARCH_SUPPLIER_TIMEOUT_MS=8000
# Flight search cache lifetime, in seconds
SEARCH_CACHE_TTL_SECONDS=600

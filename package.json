{
  "name": "tripwise",
  "private": true,
  "description": "Tripwise: multi-channel travel booking platform (B2B, B2E, B2C, POS, AI agent)",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @tripwise/api dev",
    "dev:portal": "pnpm --filter @tripwise/web-portal dev",
    "db:migrate": "pnpm --filter @tripwise/api db:migrate",
    "db:seed": "pnpm --filter @tripwise/api db:seed"
  }
}
